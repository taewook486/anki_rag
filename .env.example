# ============================================================
# Anki RAG 환경변수 템플릿
# 사용법: 본 파일을 `.env` 로 복사 후 실제 키 입력
# ============================================================

# ----- LLM Provider 선택 (둘 중 하나 필수, ANTHROPIC 우선) -----

# [권장] Anthropic Claude — console.anthropic.com 에서 발급
# 가입 + 결제수단 등록 + 최소 $5 충전 후 sk-ant-api03-... 형식
ANTHROPIC_API_KEY="sk-ant-api03-여기에-실제-키-입력"
LLM_MODEL="claude-sonnet-4-6"

# [폴백] OpenAI 호환 API (GLM / OpenRouter / DeepSeek 등)
# ANTHROPIC_API_KEY 가 비어있을 때 사용됨
# LLM_API_KEY="여기에-실제-키-입력"
# LLM_BASE_URL="https://api.z.ai/api/coding/paas/v4"
# LLM_MODEL="glm-5"

# ----- Qdrant 벡터 DB -----

# 로컬 파일 모드 (기본, 동일 경로 동시 접근 불가)
QDRANT_LOCATION="./qdrant_data"

# 인메모리 모드 (테스트용, 재시작 시 초기화)
# QDRANT_LOCATION=":memory:"

# 원격 서버 모드 (Docker 등)
# QDRANT_LOCATION="http://localhost:6333"
